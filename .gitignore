# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production & build output
/build
dist/

# misc OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs, caches, packaged artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
*.tsbuildinfo
*.tgz

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# local review persistence
.data/

# local pitch / demo notes (not tracked)
PITCH.md

# typescript / remotion locals
next-env.d.ts
REMOTION.md
/remotion

# nodeforge cli local state
.nodeforge/

# local agent tooling (Kilo skills)
/.kilo/
skills-lock.json
