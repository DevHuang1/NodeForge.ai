# Live LLM configuration — copy this file to `.env.local` and fill in values.

# ── Provider priority ─────────────────────────────────────────────────────
# Controls which provider is tried first, and which model the demo highlights
# as primary. "o" = OpenRouter first (Featherless falls back), "f" = Featherless
# first (OpenRouter falls back). Defaults to "o" when unset.
LLM_PROVIDER_PRIORITY=o

# ── Primary provider: OpenRouter ─────────────────────────────────────────
# Recommended for testing: one key, many models. Model IDs use vendor/model
# naming, e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet",
# "meta-llama/llama-3.3-70b-instruct".
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ── Fallback provider: Featherless ───────────────────────────────────────
# Used automatically if the primary provider fails. OpenAI-compatible.
# Model IDs use Owner/Model naming, e.g. "unsloth/Llama-3.3-70B-Instruct",
# "Qwen/Qwen2.5-7B-Instruct". Some models are gated behind HuggingFace OAuth
# (e.g. "meta-llama/Meta-Llama-3.1-8B-Instruct") and will 403 until you
# authorize the org at featherless.ai — use ungated model IDs instead.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct

# Optional third fallback (any OpenAI-compatible endpoint, e.g. Ollama local):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: site identity headers sent to OpenRouter / Featherless (recommended).
NEXT_PUBLIC_SITE_URL=https://nodeforge.ai
NEXT_PUBLIC_SITE_NAME=NodeForge.ai

# Optional: default temperature for live calls (0.0–1.0). The demo compares both
# workflows at the same temperature.
LLM_TEMPERATURE=0.3

# Optional: maximum output tokens per node call.
LLM_MAX_TOKENS=8192