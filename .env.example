# Live LLM configuration — copy this file to `.env.local` and fill in values.

# ── Provider priority ─────────────────────────────────────────────────────
# Controls which provider is tried first, and which model the demo highlights
# as primary. "o" = OpenRouter first (Featherless falls back), "f" = Featherless
# first (OpenRouter falls back). Defaults to "o" when unset.
LLM_PROVIDER_PRIORITY=o

# ── Primary provider: OpenRouter ─────────────────────────────────────────
# Recommended for testing: one key, many models. Model IDs use vendor/model
# naming, e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet",
# "meta-llama/llama-3.3-70b-instruct".
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ── Fallback provider: Featherless ───────────────────────────────────────
# Used automatically if the primary provider fails. OpenAI-compatible.
# Model IDs use Owner/Model naming, e.g. "unsloth/Llama-3.3-70B-Instruct",
# "Qwen/Qwen2.5-7B-Instruct". Some models are gated behind HuggingFace OAuth
# (e.g. "meta-llama/Meta-Llama-3.1-8B-Instruct") and will 403 until you
# authorize the org at featherless.ai — use ungated model IDs instead.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct

# Optional third fallback (any OpenAI-compatible endpoint, e.g. Ollama local):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: site identity headers sent to OpenRouter / Featherless (recommended).
NEXT_PUBLIC_SITE_URL=https://nodeforge.ai
NEXT_PUBLIC_SITE_NAME=NodeForge.ai

# Optional: default temperature for live calls (0.0–1.0). The demo compares both
# workflows at the same temperature.
LLM_TEMPERATURE=0.3

# Optional: maximum output tokens per node call.
LLM_MAX_TOKENS=8192

# ── Repository-aware PR review ────────────────────────────────────────────
# Optional: GitHub token for live pull-request retrieval. When unset the PR
# review falls back to the bundled offline sample (acme/notes-search#42) and
# the UI shows "only the bundled sample repository is available".
# Create one at https://github.com/settings/tokens with `repo` (private) or
# `public_repo` (public) scope. Server-side only — never shipped to the client.
GITHUB_TOKEN=

# Optional: cap on changed files fetched per pull request.
# GITHUB_MAX_FILES=30

# Execution backend for the review's test step. Only "offline" is implemented
# today; it labels every test "proposed"/"not executed" and never claims a run.
# A future "sandbox" backend (isolated, timeout/memory/network-limited) can be
# enabled here when available.
# NODEFORGE_EXECUTOR=offline

# Where review runs and audit events are persisted. Defaults to ./.data (git-
# ignored). Vercel's serverless filesystem is read-only after deploy, so runs
# automatically fall back to in-memory storage there.
# NODEFORGE_DATA_DIR=./.data

# Execution policy knobs (used by a future sandbox backend).
# NODEFORGE_EXEC_TIMEOUT_MS=30000
# NODEFORGE_EXEC_MEM_MB=512
# NODEFORGE_EXEC_CPU=1